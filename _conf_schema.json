{
  "appid": {
    "description": "游戏 appid",
    "type": "string",
    "default": "1067",
    "hint": "1067 = War Thunder。"
  },
  "language": {
    "description": "接口语言",
    "type": "string",
    "default": "zh_CN",
    "options": [
      "zh_CN",
      "en_US",
      "ru_RU",
      "de_DE"
    ]
  },
  "push_mode": {
    "description": "默认刷新模式（兼容旧订阅）",
    "type": "string",
    "default": "on_change",
    "options": [
      "on_change",
      "always"
    ],
    "hint": "旧配置默认值；新订阅建议使用 /gjma refresh mode 设置。"
  },
  "mention_users": {
    "description": "推送时 @ 订阅者",
    "type": "bool",
    "default": true
  },
  "push_batch_seconds": {
    "description": "私聊推送合并窗口（秒）",
    "type": "int",
    "default": 10,
    "slider": {
      "min": 0,
      "max": 120,
      "step": 1
    },
    "hint": "仅用于私聊；窗口内多件物品的变化合并成一条消息，0=每件单独发。群聊使用下方的固定全量推送间隔。"
  },
  "group_push_interval": {
    "description": "群聊全量推送间隔（秒）",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 5,
      "max": 3600,
      "step": 1
    },
    "hint": "每隔该时间主动抓取该群全部订阅物品，并合并成一条行情快照；首次从插件加载后开始计时。"
  },
  "chart_history_points": {
    "description": "价格图采样次数",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 2,
      "max": 50,
      "step": 1
    },
    "hint": "每次自动行情推送按物品生成折线图，展示最近 N 次成功抓取的最低售价和最高求购。"
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 1
    }
  },
  "request_retries": {
    "description": "失败重试次数",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 0,
      "max": 5,
      "step": 1
    }
  },
  "item_interval": {
    "description": "物品间隔（秒）",
    "type": "float",
    "default": 0.4,
    "slider": {
      "min": 0,
      "max": 3,
      "step": 0.1
    },
    "hint": "同一轮内多个物品之间的请求间隔。"
  },
  "account_email": {
    "description": "账号邮箱（已迁移到插件控制台）",
    "type": "string",
    "default": "",
    "invisible": true,
    "hint": "兼容字段：请使用插件控制台的账户登录页。"
  },
  "account_password": {
    "description": "账号密码（已迁移到插件控制台）",
    "type": "string",
    "default": "",
    "secret": true,
    "invisible": true,
    "hint": "兼容字段：请使用插件控制台的账户登录页。"
  },
  "twofa_code": {
    "description": "两步验证码（已废弃）",
    "type": "string",
    "default": "",
    "secret": true,
    "invisible": true,
    "hint": "兼容字段：验证码请在插件控制台提交。"
  },
  "owner_uids": {
    "description": "拥有者 UID（已迁移到插件控制台）",
    "type": "list",
    "default": [],
    "invisible": true,
    "hint": "兼容字段：请使用插件控制台的账户登录页。"
  },
  "user_subscriptions": {
    "description": "用户订阅（已迁移到插件控制台）",
    "type": "template_list",
    "default": [],
    "invisible": true,
    "templates": {
      "user_entry": {
        "name": "用户订阅",
        "display_item": "uid",
        "items": {
          "uid": {
            "description": "订阅者 UID",
            "type": "string",
            "default": ""
          },
          "target": {
            "description": "订阅所属会话",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "interval": {
            "description": "刷新间隔（秒）",
            "type": "int",
            "default": 30
          },
          "mode": {
            "description": "刷新模式",
            "type": "string",
            "default": "only_change"
          },
          "items": {
            "description": "订阅物品",
            "type": "template_list",
            "templates": {
              "item_entry": {
                "name": "物品",
                "display_item": "url",
                "items": {
                  "url": {
                    "description": "物品页链接",
                    "type": "string",
                    "default": ""
                  },
                  "interval": {
                    "description": "单独刷新间隔（秒）",
                    "type": "int",
                    "default": 30
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "payload": {
    "description": "行情输出模板（已迁移到插件控制台）",
    "type": "text",
    "default": "{\n    \"title\":\"$item_name行情报告\",\n    \"datetime\":\"时间：$datetime\",\n    \"content\":[\"卖单最低$sell_lowest_price，较上次变化$sell_change_amount($sell_change_rate)\",\n                \"买单最高$buy_highest_price，较上次变化$buy_change_amount($buy_change_rate)\",\n                \"卖单数$sell_count,较上次变化$sell_count_change_amount($sell_count_change_rate)\",\n                \"买单数$buy_count,较上次变化$buy_count_change_amount($buy_count_change_rate)\"]\n}",
    "invisible": true,
    "hint": "兼容字段：请使用插件控制台输出模板页。"
  }
}
