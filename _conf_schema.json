{
  "account_email": {
    "description": "账号邮箱",
    "type": "string",
    "default": "",
    "hint": "登录用。"
  },
  "account_password": {
    "description": "账号密码",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "登录用。不想保存密码可留空，只靠 refresh_token。"
  },
  "twofa_code": {
    "description": "两步验证码（备用）",
    "type": "string",
    "default": "",
    "hint": "平时用 /login <验证码> 提交；填这里保存也会自动提交并清空。"
  },
  "jwt_token": {
    "description": "JWT 令牌",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "一般无需手填。"
  },
  "refresh_token": {
    "description": "Refresh Token",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "自动续期用，不需要密码；可用 /gjm token <回跳链接> 导入。"
  },
  "appid": {
    "description": "游戏 appid",
    "type": "string",
    "default": "1067",
    "hint": "1067 = War Thunder。"
  },
  "language": {
    "description": "接口语言",
    "type": "string",
    "default": "zh_CN",
    "options": [
      "zh_CN",
      "en_US",
      "ru_RU",
      "de_DE"
    ]
  },
  "push_mode": {
    "description": "推送时机",
    "type": "string",
    "default": "on_change",
    "options": [
      "on_change",
      "always"
    ],
    "hint": "on_change=价格变化时推（推荐）；always=每轮都推。"
  },
  "mention_users": {
    "description": "推送时 @ 订阅者",
    "type": "bool",
    "default": true
  },
  "snapshot_mode": {
    "description": "网页快照",
    "type": "string",
    "default": "on_change",
    "options": [
      "off",
      "on_change"
    ],
    "hint": "价格变化后补一张商品页截图（off=关闭；每张约 15 秒，受冷却限制）。"
  },
  "snapshot_cooldown": {
    "description": "快照冷却（秒）",
    "type": "int",
    "default": 600,
    "slider": {
      "min": 0,
      "max": 7200,
      "step": 30
    },
    "hint": "同一会话两次截图的最小间隔（秒）。"
  },
  "payload": {
    "description": "输出模板（payload）",
    "type": "text",
    "default": "{\n    \"title\":\"$item_name行情报告\",\n    \"datetime\":\"时间：$datetime\",\n    \"content\":[\"卖单最低$sell_lowest_price，较上次变化$sell_change_amount($sell_change_rate)\",\n                \"买单最高$buy_highest_price，较上次变化$buy_change_amount($buy_change_rate)\",\n                \"卖单数$sell_count,较上次变化$sell_count_change_amount($sell_count_change_rate)\",\n                \"买单数$buy_count,较上次变化$buy_count_change_amount($buy_count_change_rate)\"],\n    \"image\":\"$image\"\n}",
    "hint": "JSON 骨架：键名不出现，按书写顺序逐行输出值；数组值一行一项；image 键=图片附件（会先拍快照再图文同发）。留空=可读文本；字段见 docs/PAYLOAD_FIELDS.md。"
  },
  "push_batch_seconds": {
    "description": "推送合并窗口（秒）",
    "type": "int",
    "default": 10,
    "slider": {
      "min": 0,
      "max": 120,
      "step": 1
    },
    "hint": "窗口内多件物品的变化合并成一条消息；0=每件单独发。"
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 1
    }
  },
  "request_retries": {
    "description": "失败重试次数",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 0,
      "max": 5,
      "step": 1
    }
  },
  "item_interval": {
    "description": "物品间隔（秒）",
    "type": "float",
    "default": 0.4,
    "slider": {
      "min": 0,
      "max": 3,
      "step": 0.1
    },
    "hint": "同一轮内多个物品之间的请求间隔。"
  },
  "owner_uids": {
    "description": "拥有者 UID",
    "type": "list",
    "default": [],
    "hint": "/login 与管理员指令的身份依据，发 /gjm id 查看；留空回退 AstrBot 管理员判定。"
  },
  "user_subscriptions": {
    "description": "用户订阅",
    "type": "template_list",
    "templates": {
      "user_entry": {
        "name": "用户订阅",
        "display_item": "uid",
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "uid": {
            "description": "订阅者 UID",
            "type": "string",
            "default": "",
            "hint": "发 /gjm id 查看。"
          },
          "note": {
            "description": "备注",
            "type": "string",
            "default": "",
            "hint": "仅用于你自己辨认。"
          },
          "interval": {
            "description": "刷新间隔（秒）",
            "type": "int",
            "default": 30,
            "slider": {
              "min": 1,
              "max": 3600,
              "step": 1
            },
            "hint": "该用户名下所有物品共用；同一物品被多人订阅时按最小间隔抓取，但推送不会快于各自设定。"
          },
          "items": {
            "description": "订阅的物品",
            "type": "list",
            "default": [],
            "hint": "每行一个物品页链接，如 https://trade.gaijin.net/market/1067/id50381_f_16xl_usa"
          }
        }
      }
    }
  }
}