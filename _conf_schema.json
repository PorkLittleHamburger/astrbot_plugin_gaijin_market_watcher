{
  "account_email": {
    "description": "账号邮箱",
    "type": "string",
    "default": "",
    "hint": "登录用。"
  },
  "account_password": {
    "description": "账号密码",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "登录用；已有登录态时可留空。"
  },
  "twofa_code": {
    "description": "两步验证码（备用）",
    "type": "string",
    "default": "",
    "secret": true,
    "hint": "平时用 /login <验证码> 提交；填这里保存也会自动提交并清空。"
  },
  "appid": {
    "description": "游戏 appid",
    "type": "string",
    "default": "1067",
    "hint": "1067 = War Thunder。"
  },
  "language": {
    "description": "接口语言",
    "type": "string",
    "default": "zh_CN",
    "options": [
      "zh_CN",
      "en_US",
      "ru_RU",
      "de_DE"
    ]
  },
  "push_mode": {
    "description": "默认刷新模式（兼容旧订阅）",
    "type": "string",
    "default": "on_change",
    "options": [
      "on_change",
      "always"
    ],
    "hint": "旧配置默认值；新订阅建议使用 /gjm refresh mode 设置。"
  },
  "mention_users": {
    "description": "推送时 @ 订阅者",
    "type": "bool",
    "default": true
  },
  "payload": {
    "description": "输出模板（payload）",
    "type": "text",
    "default": "{\n    \"title\":\"$item_name行情报告\",\n    \"datetime\":\"时间：$datetime\",\n    \"content\":[\"卖单最低$sell_lowest_price，较上次变化$sell_change_amount($sell_change_rate)\",\n                \"买单最高$buy_highest_price，较上次变化$buy_change_amount($buy_change_rate)\",\n                \"卖单数$sell_count,较上次变化$sell_count_change_amount($sell_count_change_rate)\",\n                \"买单数$buy_count,较上次变化$buy_count_change_amount($buy_count_change_rate)\"]\n}",
    "hint": "JSON 骨架：键名不出现，按书写顺序逐行输出值；数组值一行一项。留空=可读文本；字段见 docs/PAYLOAD_FIELDS.md。"
  },
  "push_batch_seconds": {
    "description": "私聊推送合并窗口（秒）",
    "type": "int",
    "default": 10,
    "slider": {
      "min": 0,
      "max": 120,
      "step": 1
    },
    "hint": "仅用于私聊；窗口内多件物品的变化合并成一条消息，0=每件单独发。群聊使用下方的固定全量推送间隔。"
  },
  "group_push_interval": {
    "description": "群聊全量推送间隔（秒）",
    "type": "int",
    "default": 30,
    "slider": {
      "min": 5,
      "max": 3600,
      "step": 1
    },
    "hint": "每隔该时间主动抓取该群全部订阅物品，并合并成一条行情快照；首次从插件加载后开始计时。"
  },
  "chart_history_points": {
    "description": "价格图采样次数",
    "type": "int",
    "default": 5,
    "slider": {
      "min": 2,
      "max": 50,
      "step": 1
    },
    "hint": "每次自动行情推送按物品生成折线图，展示最近 N 次成功抓取的最低售价和最高求购。"
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "default": 15,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 1
    }
  },
  "request_retries": {
    "description": "失败重试次数",
    "type": "int",
    "default": 2,
    "slider": {
      "min": 0,
      "max": 5,
      "step": 1
    }
  },
  "item_interval": {
    "description": "物品间隔（秒）",
    "type": "float",
    "default": 0.4,
    "slider": {
      "min": 0,
      "max": 3,
      "step": 0.1
    },
    "hint": "同一轮内多个物品之间的请求间隔。"
  },
  "owner_uids": {
    "description": "拥有者 UID",
    "type": "list",
    "default": [],
    "hint": "/login 与管理员指令的身份依据，可发送 AstrBot 内置命令 /sid 查看；留空时登录可回退 AstrBot 管理员判定，但自动交易会直接禁用。"
  },
  "user_subscriptions": {
    "description": "用户订阅",
    "type": "template_list",
    "templates": {
      "user_entry": {
        "name": "用户订阅",
        "display_item": "uid",
        "items": {
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "uid": {
            "description": "订阅者 UID",
            "type": "string",
            "default": "",
            "hint": "可发送 AstrBot 内置命令 /sid 查看。"
          },
          "target": {
            "description": "订阅所属会话",
            "type": "string",
            "default": "",
            "hint": "由插件在用户执行订阅命令时自动填写；旧配置留空时会根据 UID 的最近会话自动迁移。"
          },
          "note": {
            "description": "备注",
            "type": "string",
            "default": "",
            "hint": "仅用于你自己辨认。"
          },
          "interval": {
            "description": "刷新间隔（秒）",
            "type": "int",
            "default": 30,
            "slider": {
              "min": 1,
              "max": 3600,
              "step": 1
            },
            "hint": "always 模式使用，且仅对私聊订阅生效；群聊统一使用 group_push_interval。"
          },
          "mode": {
            "description": "刷新模式",
            "type": "string",
            "default": "only_change",
            "options": [
              "always",
              "only_change"
            ],
            "hint": "控制私聊推送；群聊统一周期性发送全量快照，不使用这里的模式。"
          },
          "items": {
            "description": "订阅物品",
            "type": "template_list",
            "templates": {
              "item_entry": {
                "name": "物品",
                "display_item": "url",
                "items": {
                  "url": {
                    "description": "物品页链接",
                    "type": "string",
                    "default": "",
                    "hint": "例如 https://trade.gaijin.net/market/1067/id50381_f_16xl_usa"
                  },
                  "interval": {
                    "description": "单独刷新间隔（秒）",
                    "type": "int",
                    "default": 30,
                    "slider": {
                      "min": 1,
                      "max": 3600,
                      "step": 1
                    },
                    "hint": "仅 always 模式使用；同一物品多人订阅时仍按最快策略抓取。"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
